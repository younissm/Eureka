# Production environment variables for Eureka
# Copy this file to .env.production and replace values before deployment.

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-secure-key
DJANGO_ALLOWED_HOSTS=eureka-backend.onrender.com,localhost
DATABASE_URL=postgresql://user:password@host:5432/eureka
CORS_ALLOWED_ORIGINS=https://eureka-frontend.onrender.com,https://your-custom-domain.com
ACCESS_TOKEN_LIFETIME=3600
REFRESH_TOKEN_LIFETIME=86400
ENVIRONMENT=production

# Frontend settings
VITE_API_URL=https://eureka-backend.onrender.com
VITE_APP_NAME=Eureka
