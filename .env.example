# Django Settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.onrender.com

# Database (Development uses SQLite, Production uses PostgreSQL)
DATABASE_URL=sqlite:///db.sqlite3
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Production Database (PostgreSQL on Render)
# Render auto-provides DATABASE_URL in production
# DATABASE_URL=postgresql://user:password@host:port/dbname

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,https://your-domain.onrender.com,https://your-frontend-domain.onrender.com

# Frontend URL
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# JWT Settings
ACCESS_TOKEN_LIFETIME=3600
REFRESH_TOKEN_LIFETIME=86400

# Environment
ENVIRONMENT=development
