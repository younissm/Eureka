# Build stage
FROM node:18-alpine as build

WORKDIR /app

COPY frontend-proto/package*.json .

RUN npm ci

COPY frontend-proto/ .

RUN npm run build

# Production stage
FROM node:18-alpine

WORKDIR /app

# Install serve to run the app
RUN npm install -g serve

COPY --from=build /app/dist ./dist

EXPOSE 3000

CMD ["serve", "-s", "dist", "-l", "3000"]
